@model IEnumerable<ProjektAsp.Models.TrainingSession>

@{
    ViewData["Title"] = "Lista Rezerwacji";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Rezerwacje Treningów (Typ 3)</h2>
        <a asp-action="Create" class="btn btn-primary">Dodaj nową rezerwację</a>
    </div>

    <table class="table table-hover shadow-sm bg-white rounded overflow-hidden">
        <thead class="table-dark">
            <tr>
                <th>Klubowicz</th>
                <th>Trener</th>
                <th>@Html.DisplayNameFor(model => model.ScheduledDate)</th>
                <th>@Html.DisplayNameFor(model => model.Price)</th>
                <th class="text-center">Akcje</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@(item.Member?.FirstName + " " + item.Member?.LastName)</td>
                <td>@(item.Trainer?.FirstName + " " + item.Trainer?.LastName)</td>
                <td>@item.ScheduledDate.ToShortDateString()</td>
                <td class="fw-bold text-success">@item.Price.ToString("F2") zł</td>
                <td class="text-center">
                    <div class="btn-group">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edytuj</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Szczegóły</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Usuń</a>
                    </div>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
