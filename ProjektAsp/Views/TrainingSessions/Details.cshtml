@model ProjektAsp.Models.TrainingSession

@{
    ViewData["Title"] = "Szczegóły Rezerwacji";
}

<div class="container mt-4">
    <h2>Szczegóły rezerwacji #@Model.Id</h2>
    <hr />
    <div class="card shadow-sm p-4">
        <dl class="row">
            <dt class="col-sm-3 fw-bold">Klubowicz</dt>
            <dd class="col-sm-9">@(Model.Member?.FirstName + " " + Model.Member?.LastName)</dd>

            <dt class="col-sm-3 fw-bold">Trener</dt>
            <dd class="col-sm-9">@(Model.Trainer?.FirstName + " " + Model.Trainer?.LastName)</dd>

            <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.ScheduledDate)</dt>
            <dd class="col-sm-9">@Model.ScheduledDate.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.Price)</dt>
            <dd class="col-sm-9 text-success fw-bold">@Model.Price.ToString("F2") zł</dd>
        </dl>
    </div>
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edytuj</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Powrót do listy</a>
    </div>
</div>
