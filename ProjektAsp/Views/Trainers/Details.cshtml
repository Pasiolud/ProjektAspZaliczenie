@model ProjektAsp.Models.Trainer

@{
    ViewData["Title"] = "Szczegóły Trenera";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <h2>Trener: @Model.FirstName @Model.LastName</h2>
        <div>
            <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Informacje</h5>
                </div>
                <div class="card-body">
                    <p><strong>Specjalizacja:</strong> @Model.Specialization</p>
                    <p><strong>ID Pracownika:</strong> #@Model.Id</p>
                </div>
            </div>
        </div>

        <div class="col-md-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Podopieczni (Sesje Treningowe)</h5>
                </div>
                <div class="card-body">
                    @if (Model.TrainingSessions != null && Model.TrainingSessions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Klubowicz</th>
                                        <th>Termin</th>
                                        <th>Przychód</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in Model.TrainingSessions)
                                    {
                                        <tr>
                                            <td>@(session.Member?.FirstName + " " + session.Member?.LastName ?? "Nieznany")</td>
                                            <td>@session.ScheduledDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td class="text-success fw-bold">@session.Price.ToString("F2") zł</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Ten trener nie ma jeszcze przypisanych żadnych sesji treningowych.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
