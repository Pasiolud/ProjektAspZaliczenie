@model ProjektAsp.Models.Review

@{
    ViewData["Title"] = "Nowa Opinia";
}

<div class="container mt-4">
    <h2>Napisz opinię o trenerze</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group mb-3">
                    <label asp-for="MemberId" class="control-label fw-bold">Wybierz Klubowicza (Autora)</label>
                    <select asp-for="MemberId" class="form-select" asp-items="ViewBag.MemberId"></select>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="TrainerId" class="control-label fw-bold">Oceniany Trener</label>
                    <select asp-for="TrainerId" class="form-select" asp-items="ViewBag.TrainerId"></select>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Rating" class="control-label fw-bold"></label>
                    <input asp-for="Rating" type="number" min="1" max="5" class="form-control" />
                    <span asp-validation-for="Rating" class="text-danger"></span>
                    <small class="form-text text-muted">Podaj wartość od 1 do 5.</small>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Comment" class="control-label fw-bold"></label>
                    <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3" style="display:none;">
                    <label asp-for="CreatedDate" class="control-label fw-bold"></label>
                    <input asp-for="CreatedDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                
                <div class="form-group">
                    <input type="submit" value="Dodaj Opinię" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Powrót do opinii</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
