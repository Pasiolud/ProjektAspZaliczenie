@model ProjektAsp.Models.GroupClass

@{
    ViewData["Title"] = "Zapisz uczestnika";
}

<div class="container mt-4">
    <h2>Zapisz uczestnika na zajęcia: @Model.Name</h2>
    <hr />

    <div class="mb-4">
        <h5>Obecni uczestnicy (@(Model.Members?.Count ?? 0) / @Model.Capacity)</h5>
        <ul>
            @if (Model.Members != null && Model.Members.Any())
            {
                foreach (var member in Model.Members)
                {
                    <li>@member.FirstName @member.LastName</li>
                }
            }
            else
            {
                <li>Brak uczestników</li>
            }
        </ul>
    </div>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Enroll">
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Wybierz Klubowicza</label>
                    <select name="memberId" class="form-control">
                        @foreach (var m in ViewBag.MembersList as IEnumerable<ProjektAsp.Models.Member>)
                        {
                            <option value="@m.Id">@m.FirstName @m.LastName</option>
                        }
                    </select>
                </div>
                
                <div class="form-group">
                    <input type="submit" value="Zapisz go na listę" class="btn btn-success" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Wróć do listy</a>
                </div>
            </form>
        </div>
    </div>
</div>
