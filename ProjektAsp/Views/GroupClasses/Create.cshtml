@model ProjektAsp.Models.GroupClass

@{
    ViewData["Title"] = "Nowe Zajęcia";
}

<div class="container mt-4">
    <h2>Utwórz nowe zajęcia grupowe</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-4">
                    <label asp-for="Capacity" class="control-label fw-bold"></label>
                    <input asp-for="Capacity" class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <input type="submit" value="Utwórz" class="btn btn-success" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Powrót</a>
                </div>
            </form>
        </div>
    </div>
</div>
