@model ProjektAsp.ViewComponents.GymSummaryViewModel

<div class="alert alert-dark shadow-sm mt-5 mb-0 py-3">
    <div class="container">
        <div class="row text-center align-items-center">
            <div class="col-md-4 border-end border-secondary">
                <span class="text-muted small text-uppercase">Zarejestrowani Klubowicze</span>
                <h4 class="mb-0 fw-bold text-primary">@Model.MembersCount</h4>
            </div>
            <div class="col-md-4 border-end border-secondary">
                <span class="text-muted small text-uppercase">Aktywna Kadra</span>
                <h4 class="mb-0 fw-bold text-danger">@Model.TrainersCount</h4>
            </div>
            <div class="col-md-4">
                <span class="text-muted small text-uppercase">Otwarte Sekcje</span>
                <h4 class="mb-0 fw-bold text-success">@Model.ClassesCount</h4>
            </div>
        </div>
    </div>
</div>
