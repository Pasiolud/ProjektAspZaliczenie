@model ProjektAsp.Models.Member

@{
    ViewData["Title"] = "Profil Klubowicza";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <h2>Profil: @Model.FirstName @Model.LastName</h2>
        <div>
            <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Zajęcia Grupowe (Typ 1: Implicit)</h5>
                </div>
                <div class="card-body">
                    @if (Model.GroupClasses != null && Model.GroupClasses.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var gc in Model.GroupClasses)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @gc.Name
                                    <span class="badge bg-success rounded-pill">Zapisany</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">Brak zapisów na zajęcia grupowe.</p>
                        <a asp-controller="GroupClasses" asp-action="Index" class="btn btn-sm btn-outline-primary">Zapisz się teraz</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Treningi Personalne (Typ 3: Payload)</h5>
                </div>
                <div class="card-body">
                    @if (Model.TrainingSessions != null && Model.TrainingSessions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Trener</th>
                                        <th>Data</th>
                                        <th>Cena</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ts in Model.TrainingSessions)
                                    {
                                        <tr>
                                            <td>@(ts.Trainer?.FirstName + " " + ts.Trainer?.LastName ?? "Nieprzypisany")</td>
                                            <td>@ts.ScheduledDate.ToShortDateString()</td>
                                            <td class="fw-bold text-success">@ts.Price.ToString("F2") zł</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Brak umówionych treningów personalnych.</p>
                        <a asp-controller="TrainingSessions" asp-action="Create" class="btn btn-sm btn-outline-warning text-dark">Umów trening</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
